# ==============================================================================
# 🌐 Global Configuration
# ==============================================================================
NODE_ENV=development
API_VERSION=v1
LOG_LEVEL=info

# ==============================================================================
# 🚦 Port Configurations
# ==============================================================================
CUSTOMER_PORT=3013
MANAGEMENT_PORT=3014
BACKEND_PORT=3015

# ==============================================================================
# 🔗 URLs & Origins
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3015/api/v1
CORS_ORIGIN_CUSTOMER=http://localhost:3013
CORS_ORIGIN_MANAGEMENT=http://localhost:3014

# ==============================================================================
# 🗄️ Database (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=easy-fashion
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy-fashion?schema=public

# ==============================================================================
# 🔐 JWT Secrets
# ==============================================================================
# Generate secure keys using: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_key_12345
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_12345
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# 👤 Super Admin Defaults
# ==============================================================================
ADMIN_EMAIL=admin@easyfashion.com
SUPER_ADMIN_EMAIL=admin@easyfashion.com
SUPER_ADMIN_PASSWORD=admin123!

# ==============================================================================
# 🛡️ Rate Limiting & Security
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10
ANALYTICS_HASH_SECRET=your_analytics_hash_secret_key_12345

# ==============================================================================
# 📦 Redis / Caching
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_MAX=100

# ==============================================================================
# 🔑 OAuth / Third-Party Logins (Google & Facebook)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3015/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=http://localhost:3015/api/v1/auth/facebook/callback

# ==============================================================================
# ☁️ Cloudinary (Image Hosting)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# 🔧 Docker Compose Local Dev Additions
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=admin@easyfashion.com
PGADMIN_DEFAULT_PASSWORD=admin
